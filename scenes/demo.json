{
  "id": "demo",
  "titleKey": "scene.demo.name",
  "length": 40,
  "playerStart": 2,
  "musicDay": "assets/musics/jazz_day",
  "musicNight": "assets/musics/jazz_night",
  "ambiences": ["assets/ambiances/traffic_1.mp3"],
  "defaultSurface": "dirt",
  "segments": [{ "from": 15, "to": 35, "surface": "grass" }],
  "spawnRanges": [{ "from": 27, "to": 34, "count": 3, "distribution": { "table": "default" } }],
  "entities": [
    { "id": "money_1", "type": "money", "x": 5 },
    { "id": "bush_1", "type": "bush", "x": 12 },
    { "id": "counter_1", "type": "shop_counter", "x": 38,
      "shop": { "catalog": { "items": {"apple": {"stock": 5}, "coin": {"stock": 20}, "sneakers": {"stock": 1}, "leather_boots": {"stock": 1}, "ceramic_capacitor": {"stock": 3}} } } },
    { "id": "miravi_test", "type": "miravi", "x": 5, "isFlying": true, "behavior": { "kind": "wander" } },
    {
      "id": "door_exit",
      "type": "automatic_sliding_door",
      "x": 9,
      "sounds": {
        "beacon": { "path": "assets/sounds/doors/roller_shutter_1_close", "loop": true, "condition": { "type": "timeRange", "from": 20, "to": 8 } },
        "approachSound": { "condition": { "type": "timeRange", "from": 8, "to": 20 } },
        "leaveSound": { "condition": { "type": "timeRange", "from": 8, "to": 20 } },
        "proximityLoop": { "path": "assets/sounds/doors/shop_door_bell_1_beacon", "condition": { "type": "timeRange", "from": 8, "to": 20 } }
      },
      "triggers": [
        { "on": "hour", "hour": 8, "effects": [{ "type": "playSound", "path": "assets/sounds/doors/garage_door_1_open" }] },
        { "on": "hour", "hour": 20, "effects": [{ "type": "playSound", "path": "assets/sounds/doors/garage_door_1_close" }] }
      ],
      "action": {
        "kind": "applyEffects",
        "condition": { "type": "timeRange", "from": 8, "to": 20 },
        "refusalEffects": [{ "type": "announce", "key": "door.default.shop_hours_refusal" }],
        "effects": [{ "type": "teleport", "target": "demo2" }]
      }
    },
    { "id": "apple_1", "type": "apple", "x": 17 },
    { "id": "resistor_1", "type": "item", "x": 3, "action": { "kind": "pickup", "item": "resistor", "count": 1 } },
    { "id": "transistor_1", "type": "item", "x": 14, "action": { "kind": "pickup", "item": "transistor", "count": 1 } },
    { "id": "object_neon", "type": "neon", "x": 30 },
    { "id": "bird_1", "type": "bird_1", "x": 33 },
    { "id": "perched_bird_1", "type": "perched_bird_2", "x": 16, "behavior": { "kind": "wander", "speed": 0.15, "walkMinMs": 1000, "walkMaxMs": 2500, "pauseMinMs": 3000, "pauseMaxMs": 8000 } },
    { "id": "perched_bird_2", "type": "perched_bird_3", "x": 23, "behavior": { "kind": "wander", "speed": 0.15, "walkMinMs": 1000, "walkMaxMs": 2500, "pauseMinMs": 3000, "pauseMaxMs": 8000 } },
    { "id": "perched_bird_tame", "type": "perched_bird_1", "x": 31, "startle": { "range": 0.5 }, "behavior": { "kind": "wander", "speed": 0.15, "walkMinMs": 1000, "walkMaxMs": 2500, "pauseMinMs": 3000, "pauseMaxMs": 8000 } },
    { "id": "spirit_1", "type": "ghost", "x": 36 },
    {
      "id": "npc_resident",
      "type": "npc",
      "x": 20,
      "nameKey": "npc.resident.name",
      "descriptionKey": "npc.resident.description",
      "speed": 0.5,
      "behavior": { "kind": "wander", "walkMinMs": 3000, "walkMaxMs": 6000, "pauseMinMs": 1000, "pauseMaxMs": 2500 },
      "presence": [
        { "when": { "type": "arrived" }, "effects": [{ "type": "presence", "present": false }] },
        { "when": { "type": "timeRange", "from": 23, "to": 8 }, "effects": [{ "type": "presence", "present": false }] },
        {
          "when": { "type": "timeRange", "from": 8, "to": 20 },
          "effects": [
            { "type": "presence", "present": true },
            { "type": "behavior", "behavior": { "kind": "wander", "walkMinMs": 3000, "walkMaxMs": 6000, "pauseMinMs": 1000, "pauseMaxMs": 2500 } }
          ]
        },
        {
          "when": { "type": "timeRange", "from": 20, "to": 23 },
          "effects": [
            { "type": "presence", "present": true },
            { "type": "behavior", "behavior": { "kind": "goto", "targetId": "door_exit" } }
          ]
        }
      ]
    },
    {
      "id": "door_club",
      "type": "door",
      "x": 25,
      "nameKey": "door.club.name",
      "descriptionKey": "door.club.description",
      "action": {
        "kind": "applyEffects",
        "condition": { "type": "hasEquipmentTag", "tag": "chic" },
        "refusalEffects": [{ "type": "announce", "key": "door.club.dresscode_refused" }],
        "effects": [{ "type": "playSound", "path": "assets/sounds/doors/door_1_open" }, { "type": "teleport", "target": "demo2" }]
      }
    },
    { "id": "storm_drain_1", "type": "storm_drain", "x": 7 },
    { "id": "wood_bench_1", "type": "wood_bench", "x": 27 },
    { "id": "wall_air_conditioner_1", "type": "wall_air_conditioner", "x": 35 },
    {
      "id": "stray_dog_1",
      "type": "dog",
      "x": 29,
      "behavior": { "kind": "wander", "walkMinMs": 1000, "walkMaxMs": 2500, "pauseMinMs": 2000, "pauseMaxMs": 6000 },
      "triggers": [
        {
          "on": "emote",
          "emote": "whistle",
          "effects": [
            { "type": "temporaryBehavior", "behavior": { "kind": "follow", "speed": 1.6, "maxDistance": 1.5 }, "durationMs": 10000 },
            { "type": "playSound", "path": "assets/sounds/entities/dog_medium_vocal" }
          ]
        }
      ]
    }
  ]
}
